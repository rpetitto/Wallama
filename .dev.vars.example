# Copy to .dev.vars for `npm run dev`. Never commit the real file.
# In deployed environments these are set with `npx wrangler secret put NAME`.

# Claude: post refinement, the K-12 safety check, and wall icon suggestions. https://console.anthropic.com/settings/keys
# Make the key inside a workspace. An organization-level key also works, but
# then the workspace to bill has to be named: ANTHROPIC_WORKSPACE_ID=wrkspc_...
ANTHROPIC_API_KEY=

# Giphy: the GIF tab in the post editor.
GIPHY_API_KEY=

# Pexels: the image-search tab in the post editor and the wall background picker.
PEXELS_API_KEY=

# Administrators: Google accounts treated as the teacher of every wall, by
# email, separated by commas. Kept out of the code because the repository is
# public. Deployed, it comes from the ADMIN_EMAILS repository secret.
ADMIN_EMAILS=
