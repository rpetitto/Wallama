{
  // Wallama on Cloudflare: Workers for the API, D1 for walls and posts, R2 for
  // the images and videos people put on them.
  //
  // `nodejs_compat` is required: the request-scoping seam in src/worker/platform
  // uses AsyncLocalStorage so two requests sharing an isolate can never end up
  // pointed at the same bindings by accident.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallama",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // The app is served at wallama.com. `custom_domain` means Cloudflare owns
  // the DNS record and the certificate for these names, rather than expecting
  // a record maintained by hand.
  "routes": [
    { "pattern": "wallama.com", "custom_domain": true },
    { "pattern": "www.wallama.com", "custom_domain": true }
  ],

  // A Google client id is public by design — it appears in the page source of
  // every site that offers Google sign-in. It lives here rather than as a secret
  // because the Worker needs it to check that an ID token was issued to *this*
  // app, and there is no matching secret to protect: sign-in verifies Google's
  // signature rather than exchanging a code.
  "vars": {
    "GOOGLE_CLIENT_ID": "6888240288-dc3k5idvqc5q37dvlrd376q78bf7v4sm.apps.googleusercontent.com",
    "ANTHROPIC_MODEL": "claude-opus-5"
    // If ANTHROPIC_API_KEY is an organization-level key rather than one made
    // inside a workspace, add the workspace to bill here — it's an identifier,
    // not a secret:  "ANTHROPIC_WORKSPACE_ID": "wrkspc_..."
  },

  // The built SPA is served straight from the edge; only /api/* reaches the
  // Worker, so loading a wall costs no Worker invocation for the page itself.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallama",
      // Replace with the id printed by `npx wrangler d1 create wallama`.
      "database_id": "388697cf-6d8e-43aa-899f-302d36e5cf93"
    }
  ],

  // Post images and videos. They used to be base64 data URLs inside the
  // database row, which D1 will not carry — see src/worker/routes/media.ts.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wallama-media"
    }
  ]
}
